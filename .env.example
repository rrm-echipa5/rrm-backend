# Copiază fișierul în .env și modifică valorile pentru mașina ta.
RRM_API_PREFIX=/api
RRM_DATABASE_URL=postgresql+psycopg://rrm:rrm@localhost:5432/rrm
RRM_CORS_ORIGINS=["http://localhost:5173"]
# Utilizatorul în numele căruia se fac cererile până la autentificare (4 = Mihai Ionescu).
RRM_DEMO_USER_ID=4
